[Desktop Entry]
Type=Application
Name=RealRDP
GenericName=Remote Desktop Client
Comment=Connect to a Windows desktop or RemoteApp over RDP
Comment[nl]=Verbind met een Windows-bureaublad of RemoteApp via RDP
Exec=realrdp %U
StartupWMClass=realrdp
MimeType=application/x-rdp;
Icon=realrdp
Terminal=false
Categories=Network;RemoteAccess;
Keywords=rdp;remote;desktop;windows;
