# Maintainer: Jeremy van Wijngaarden <jeremy.vanwijngaarden@vanschie.com>
# Release checklist: tag RealRDP v$pkgver; bump _ironrdp_tag only when the IronRDP patches change.
_gh_user=JeremyvanWijngaarden
_ironrdp_tag=realrdp-v0.1.5
pkgname=realrdp
pkgver=0.1.5
pkgrel=1
pkgdesc="mstsc-compatible Remote Desktop (RDP) client with RemoteApp support, built on IronRDP"
arch=('x86_64')
url="https://github.com/$_gh_user/RealRDP"
license=('MIT')
depends=('alsa-lib' 'dbus' 'hicolor-icon-theme' 'libx11' 'libxi' 'libxkbcommon' 'libxkbcommon-x11' 'vulkan-icd-loader')
makedepends=('cargo' 'git')
# Opens .rdp files from a file manager (MIME type) and keeps itself updatable (pacman.d repo file).
depends+=('shared-mime-info')
backup=('etc/pacman.d/realrdp-repo')
# aws-lc-sys and the opus codec build C code with makepkg's CFLAGS; with -flto=auto those static
# archives become GCC bitcode that rust-lld cannot link.
options=(!lto)
optdepends=('cups: printer redirection'
            'kwallet: saving credentials (any org.freedesktop.secrets provider works)'
            'xdg-desktop-portal: file and folder dialogs'
            'zenity: error dialogs')
# IronRDP is a git dependency patched to ../IronRDP in Cargo.toml, so the fork is checked out next to
# the source tree: makepkg puts the git source in $srcdir/IronRDP, exactly where the patch looks.
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz"
        "IronRDP::git+https://github.com/$_gh_user/IronRDP.git#tag=$_ironrdp_tag")
sha256sums=('99b09060ecaf3ab1b1cc99f9fa1ff0f0fa2febe083ab3e81cedd3630439329e1'
            '076b0879cbb25362cc225ff991a7929288e07175f7b2815b61185654fab3fc08')

# The binary is published to the pacman repo, so build for baseline x86-64 rather than whatever
# makepkg.conf targets (CachyOS defaults to -march=native / target-cpu=native: SIGILL on other CPUs).
_portable_flags() {
    export RUSTFLAGS="${RUSTFLAGS//target-cpu=native/target-cpu=x86-64}"
    export CFLAGS="${CFLAGS//-march=native/-march=x86-64 -mtune=generic}"
    export CXXFLAGS="${CXXFLAGS//-march=native/-march=x86-64 -mtune=generic}"
}

prepare() {
    cd "RealRDP-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "RealRDP-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    _portable_flags
    cargo build --frozen --release
}

check() {
    cd "RealRDP-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    _portable_flags
    cargo test --frozen --release
}

package() {
    cd "RealRDP-$pkgver"
    install -Dm755 target/release/RealRDP "$pkgdir/usr/bin/realrdp"
    install -Dm644 realrdp-icons/realrdp.desktop "$pkgdir/usr/share/applications/realrdp.desktop"
    for icon in realrdp-icons/hicolor/*/apps/realrdp.*; do
        install -Dm644 "$icon" "$pkgdir/usr/share/icons/${icon#realrdp-icons/}"
    done
    install -Dm644 realrdp-icons/realrdp-mime.xml "$pkgdir/usr/share/mime/packages/realrdp.xml"
    install -Dm644 packaging/pacman/realrdp-repo "$pkgdir/etc/pacman.d/realrdp-repo"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
